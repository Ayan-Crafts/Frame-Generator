*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
*.m4v
*.ts
*.mts
*.m2ts
*.vob
*.3gp
*.mxf
*.m2v
*.f4v
*.mpg
*.mpeg

# Partial & Incomplete Downloads
*.crdownload
*.part
*.download

# ------------------------------------------------------------------------------
# Image Sequence & Frame Extractions
# ------------------------------------------------------------------------------
*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.tiff
*.tif
*.raw
*.heic

# ------------------------------------------------------------------------------
# Dataset & Frame Output Directories
# ------------------------------------------------------------------------------
Datasets/
datasets/
dataset/
output/
outputs/
frames/
extracted_frames/
benchmark_frames/
squash*/

# ------------------------------------------------------------------------------
# Bundled Binaries & Large Executables (> 100MB)
