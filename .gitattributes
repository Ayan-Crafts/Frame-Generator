# Shell scripts and Debian maintainer scripts must keep LF endings even when
# checked out on Windows, or they fail inside Linux containers.
*.sh            text eol=lf
packaging/linux/debian/*  text eol=lf
*.desktop       text eol=lf
*.ps1           text eol=crlf
*.iss           text eol=crlf
*.mp4           binary
*.png           binary
*.ico           binary
